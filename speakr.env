# =============================================================================
# Configuration du connecteur de transcription
# =============================================================================
#
# Speakr prend en charge plusieurs fournisseurs de transcription grâce à une
# architecture basée sur des connecteurs.
# Ce fichier documente toutes les options de configuration disponibles.
#
# Démarrage rapide (simplifié) :
# 1. Pour OpenAI avec diarisation :
#    Définissez TRANSCRIPTION_MODEL=gpt-4o-transcribe-diarize
#
# 2. Pour un ASR auto-hébergé :
#    Définissez ASR_BASE_URL=http://your-asr:9000
#
# 3. Pour Whisper legacy :
#    Définissez TRANSCRIPTION_API_KEY et éventuellement TRANSCRIPTION_MODEL
#
# Priorité de détection automatique :
# 1. TRANSCRIPTION_CONNECTOR - nom explicite du connecteur (si contrôle total nécessaire)
# 2. ASR_BASE_URL - si défini, utilise le connecteur ASR endpoint
# 3. TRANSCRIPTION_MODEL contient 'gpt-4o' - utilise le connecteur OpenAI Transcribe
# 4. Par défaut - utilise OpenAI Whisper avec TRANSCRIPTION_MODEL ou whisper-1

# Paramétrage du PROXY
HTTP_PROXY=http://proxy.univ-lemans.fr:3128
HTTPS_PROXY=http://proxy.univ-lemans.fr:3128
NO_PROXY=iutlm-ia1.univ-lemans.fr,localhost,127.0.0.1,whisperx-asr
# =============================================================================
# MODÈLE DE GÉNÉRATION DE TEXTE
# (Optionnel pour les résumés, titres, chat)
# =============================================================================
#
# Speakr utilise un modèle texte/LLM pour générer les résumés, titres et le chat.
# Ce modèle est séparé du modèle de transcription (STT).
TEXT_MODEL_BASE_URL=http://iutlm-ia1.univ-lemans.fr:11434/v1
TEXT_MODEL_API_KEY=rien
TEXT_MODEL_NAME=gemma4:26b

# --- Configuration du modèle de chat (optionnel) ---
# Configure un modèle séparé pour les interactions de chat en temps réel.
# Si non défini, le chat utilisera les paramètres TEXT_MODEL_* ci-dessus.
CHAT_MODEL_API_KEY=rien
CHAT_MODEL_BASE_URL=http://iutlm-ia1.univ-lemans.fr:11434/v1
CHAT_MODEL_NAME=ministral-3:8b

# Timeout requêtes LLM en secondes (pour modèles lents)
LLM_REQUEST_TIMEOUT= 350

# =============================================================================
# CONFIGURATION ASR ENDPOINT
# (pour les services Whisper auto-hébergés)
# =============================================================================
#
# URL de base de votre service ASR
#
# Compatible avec :
# - whisper-asr-webservice
# - WhisperX
# - services compatibles
ASR_BASE_URL=http://whisperx-asr:9000

# Timeout des requêtes en secondes
# (défaut : 1800 = 30 minutes)
# Augmentez cette valeur pour les fichiers audio très longs.
ASR_TIMEOUT=1800

# Active la diarisation des locuteurs (défaut : true)
ASR_DIARIZE=true

# Retourne les embeddings des locuteurs pour l’identification vocale
# (WhisperX uniquement)
# Permet la correspondance automatique des locuteurs entre plusieurs enregistrements.
ASR_RETURN_SPEAKER_EMBEDDINGS=true

# =============================================================================
# CONFIGURATION VIBEVOICE (auto-hébergé via vLLM)
# =============================================================================
#
# Le modèle ASR VibeVoice de Microsoft fournit transcription,
# diarisation, timestamps et détection de langue pour plus de 50 langues.
#
# Il fonctionne sur votre propre matériel via vLLM et gère jusqu’à 60 minutes
# par requête.
#
# Les fichiers plus longs sont automatiquement découpés par l’application.
#
# Pré-requis :
# - Serveur vLLM avec le modèle VibeVoice chargé
# - GPU(s) avec suffisamment de VRAM
#   (bf16 nécessite ~18 Go, compatible avec 2 GPU grand public)
#
# TRANSCRIPTION_CONNECTOR=vibevoice
# TRANSCRIPTION_BASE_URL=http://your-vllm-server:8000
# TRANSCRIPTION_MODEL=vibevoice
#
# Si votre serveur vLLM nécessite une authentification :
# TRANSCRIPTION_API_KEY=your_api_key

# =============================================================================
# PARAMÈTRES DE L’APPLICATION
# =============================================================================

# --- Utilisateur administrateur (créé au premier démarrage) ---
ADMIN_USERNAME=criut
ADMIN_EMAIL=criut@example.fr
ADMIN_PASSWORD=criut_super_secure

# --- Inscription & accès ---
ALLOW_REGISTRATION=false

# Liste des domaines email autorisés séparés par des virgules.
# Laisser vide pour autoriser tous les domaines.
# Exemple : company.com,subsidiary.org
REGISTRATION_ALLOWED_DOMAINS=

# --- Limites de tokens ---
SUMMARY_MAX_TOKENS=30000
CHAT_MAX_TOKENS=5000

# --- Fuseau horaire ---
# Utilisez un nom TZ valide
# (ex : "Europe/Paris", "UTC")
TIMEZONE="Europe/Paris"

# --- Logs ---
LOG_LEVEL="INFO"

# =============================================================================
# TRAITEMENT AUDIO
# =============================================================================

# --- Compression audio ---
# Compresse automatiquement les uploads sans perte (WAV, AIFF)
# afin d’économiser de l’espace disque.
AUDIO_COMPRESS_UPLOADS=true

# Codec cible :
# - mp3 : avec perte, plus léger
# - flac : sans perte
# - opus : avec perte, très efficace
AUDIO_CODEC=mp3

# Bitrate pour les codecs avec perte
# (ignoré pour FLAC)
AUDIO_BITRATE=128k

# Codecs non supportés
# Liste séparée par des virgules des codecs à exclure
#
# AUDIO_UNSUPPORTED_CODECS=opus,vorbis

# =============================================================================
# FONCTIONNALITÉS OPTIONNELLES
# =============================================================================

# --- Création de dossiers dans l'interface ---
ENABLE_FOLDERS=true

# --- Mode Enquete (recherche IA sur tous les enregistrements) ---
ENABLE_INQUIRE_MODE=true

# --- Traitement automatique des fichiers (répertoire Black Hole) ---
ENABLE_AUTO_PROCESSING=true
AUTO_PROCESS_MODE=admin_only
AUTO_PROCESS_WATCH_DIR=/data/auto-process

# --- Export automatique ---
ENABLE_AUTO_EXPORT=true
AUTO_EXPORT_DIR=/data/exports

# --- Suppression automatique & rétention ---
ENABLE_AUTO_DELETION=false
# GLOBAL_RETENTION_DAYS=90
# DELETION_MODE=audio_only

# --- Paramètres de partage ---
ENABLE_INTERNAL_SHARING=false
ENABLE_PUBLIC_SHARING=true
SHOW_USERNAMES_IN_UI=true

# --- Contrôles de permissions ---
USERS_CAN_DELETE=true

# Supprime les profils de locuteurs lorsque tous leurs enregistrements sont supprimés.
#
# Défaut : false
# (les profils et embeddings vocaux sont conservés)
#
# Définissez sur true pour les déploiements sensibles à la confidentialité
# où les données biométriques vocales ne doivent pas survivre aux enregistrements.
DELETE_ORPHANED_SPEAKERS=true

# --- Conservation vidéo ---
# Lorsqu’activé, les vidéos uploadées conservent leur flux vidéo
# pour lecture dans le navigateur.
#
# L’audio est extrait dans un fichier temporaire pour transcription,
# puis supprimé.
#
# Défaut : false
# (les vidéos sont converties en audio uniquement)
VIDEO_RETENTION=true

# --- Passage direct des vidéos vers l’ASR ---
# Envoie directement les fichiers vidéo au backend ASR sans extraction audio.
#
# Utile pour les backends ASR personnalisés capables de traiter la vidéo
# directement (ex : extraction multi-pistes).
#
# Lorsqu’activé :
# - les vidéos contournent l’extraction audio
# - les vidéos contournent la conversion de codec
# - les vidéos contournent le chunking
#
# N’affecte que les fichiers vidéo.
# Les fichiers audio sont traités normalement.
#
# Défaut : false
# VIDEO_PASSTHROUGH_ASR=false

# --- Uploads simultanés ---
# Nombre maximal d’uploads simultanés (défaut : 3)
MAX_CONCURRENT_UPLOADS=3

# =============================================================================
# TRAITEMENTS EN ARRIÈRE-PLAN
# =============================================================================

# Workers de transcription (défaut : 2)
JOB_QUEUE_WORKERS=1

# Workers de résumé (défaut : 2)
SUMMARY_QUEUE_WORKERS=1

# Nombre maximal de tentatives pour les tâches échouées (défaut : 3)
JOB_MAX_RETRIES=3

# =============================================================================
# PARAMÈTRES DOCKER / BASE DE DONNÉES
# =============================================================================

# URI de base de données
# SQLite (défaut) ou PostgreSQL
SQLALCHEMY_DATABASE_URI=sqlite:////data/instance/transcriptions.db

# Pour PostgreSQL :
# postgresql://username:password@hostname:5432/database_name
UPLOAD_FOLDER=/data/uploads

# =============================================================================
# PARAMÈTRES SSO
# =============================================================================
# Activer l’authentification SSO (Single Sign-On).
# Nécessite l’URL de découverte et les identifiants client.
# ENABLE_SSO=false

# Nom affiché du fournisseur (visible sur le bouton dans l’interface)
# SSO_PROVIDER_NAME=Keycloak

# Identifiants client OIDC
# SSO_CLIENT_ID=speakr
# SSO_CLIENT_SECRET=change-me

# URL du document de découverte OIDC (endpoint well-known)
# SSO_DISCOVERY_URL=https://keycloak.example.com/realms/master/.well-known/openid-configuration

# URI publique de redirection exposée par Speakr
# (doit être enregistrée dans le fournisseur d’identité)
# SSO_REDIRECT_URI=https://speakr.example.com/auth/sso/callback

# Paramètres d’inscription automatique

# Autorise la création automatique de comptes
# pour les nouveaux utilisateurs se connectant via le SSO.
# SSO_AUTO_REGISTER=true

# Liste des domaines e-mail autorisés pour l’inscription automatique,
# séparés par des virgules.
# Laisser vide pour autoriser tous les domaines
# (ex. : example.com, company.org).

# SSO_ALLOWED_DOMAINS=
#
# Claims utilisés pour mapper les champs du profil utilisateur
# SSO_DEFAULT_USERNAME_CLAIM=preferred_username
# SSO_DEFAULT_NAME_CLAIM=name
