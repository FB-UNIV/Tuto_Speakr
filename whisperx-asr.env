# Configuration du service API WhisperX ASR
# Jeton Hugging Face (OBLIGATOIRE pour la diarisation des locuteurs)
# Obtenez votre jeton depuis https://huggingface.co/settings/tokens
# Acceptez les conditions d’utilisation pour LES TROIS modèles :
# - https://huggingface.co/pyannote/speaker-diarization-community-1
# - https://huggingface.co/pyannote/speaker-diarization-3.1
# - https://huggingface.co/pyannote/segmentation-3.0
HF_TOKEN=votre_token_super_secure

# Paramétrage du PROXY
HTTP_PROXY=http://proxy.univ-lemans.fr:3128
HTTPS_PROXY=http://proxy.univ-lemans.fr:3128
NO_PROXY=localhost,127.0.0.1,speakr

# Configuration du périphérique
# Options : cuda, cpu
DEVICE=cuda

# Type de calcul
# Options : float16 (GPU), float32 (CPU), int8 (CPU, qualité plus faible mais plus rapide)
COMPUTE_TYPE=float16

# Taille des lots (batch size) — à ajuster selon la mémoire GPU disponible
# Plus la valeur est grande = plus rapide mais utilise plus de mémoire
# Valeur par défaut adaptée automatiquement au périphérique si non définie :
# 16 sur cuda, 2 sur cpu.
# Recommandé :
# - 16 pour 8 Go de VRAM
# - 32 pour 16 Go+ de VRAM
# - 1-2 sur CPU
BATCH_SIZE=16

# Répertoire de cache (dans le conteneur)
# Utilisé pour les modèles WhisperX et les modèles d’alignement
# CACHE_DIR=/.cache

# Répertoire de cache Hugging Face
# Utilisé pour les modèles de diarisation pyannote — définir identique à CACHE_DIR
# pour un cache unifié.
# Permet une utilisation hors ligne après le premier téléchargement des modèles.
# Défini automatiquement dans docker-compose.yml pour correspondre à CACHE_DIR
# HF_HOME=/.cache

# Mode hors ligne (OPTIONNEL)
# Définir à 1 pour exécuter en mode hors ligne
# (aucune requête réseau vers Hugging Face)
# Nécessite que tous les modèles soient déjà en cache :
# exécuter une première fois avec un accès Internet.
# Voir la section "Offline Use" du README.md pour plus de détails
# HF_HUB_OFFLINE=1

# Préchargement des modèles (OPTIONNEL)
# Précharge un modèle spécifique au démarrage afin de réduire
# la latence de la première requête.
# Options : tiny, base, small, medium, large-v2, large-v3
# Laisser vide ou commenter pour désactiver le préchargement
PRELOAD_MODEL=large-v3

# Taille maximale des fichiers (OPTIONNEL)
# Taille maximale des fichiers audio en Mo afin d’éviter
# les erreurs de mémoire insuffisante.
# Les gros fichiers peuvent saturer la VRAM du GPU.
# Valeur par défaut : 1000 Mo (1 Go)
# Ajuster selon la mémoire GPU disponible
# (plus bas pour les GPU de 8 à 16 Go)
MAX_FILE_SIZE_MB=1000

# ---------------------------------------------------------------------------
# Déchargement des modèles inactifs (OPTIONNEL, nouveau dans v0.3.2)
# ---------------------------------------------------------------------------
# Décharge les modèles Whisper de la mémoire après ce nombre de secondes
# d’inactivité.
# La requête suivante recharge automatiquement le modèle si nécessaire.
# Valeur par défaut : 0 = désactivé
# (comportement identique aux versions avant v0.3.2).
# Utile si plusieurs modèles sont utilisés en rotation afin de libérer la VRAM.
# MODEL_KEEP_ALIVE_SECONDS=3600          # déchargement après 1 heure d’inactivité

# Fréquence de vérification du démon de déchargement
# Exemple :
# (minimum : 30 secondes)
# MODEL_EVICTION_INTERVAL_SECONDS=60

# ---------------------------------------------------------------------------
# Mode d’exécution
# ---------------------------------------------------------------------------
# simple = uvicorn avec file GPU asynchrone
#          (par défaut, compatible avec les anciennes versions)
# ray    = Ray Serve avec batch inter-requêtes
#          et parallélisme par étape du pipeline
SERVE_MODE=simple

# Concurrence GPU pour le mode simple
# (nombre d’exécutions simultanées du pipeline GPU)
# Valeur par défaut : 1
# (sécurisé pour les configurations à un seul GPU)
# GPU_CONCURRENCY=1

# Stratégie du pipeline (utilisée uniquement si SERVE_MODE=ray)
#   replicate = pipeline complet sur chaque GPU
#                (par défaut, meilleur débit multi-GPU)
#   split     = déploiements séparés par étape
#                (pour un redimensionnement indépendant des étapes)
# PIPELINE_STRATEGY=replicate

# ---------------------------------------------------------------------------
# Configuration Ray Serve
# (utilisée uniquement si SERVE_MODE=ray)
# ---------------------------------------------------------------------------
# Port du tableau de bord Ray
# (accessible via http://host:8265)
# RAY_DASHBOARD_PORT=8265

# Taille des lots inter-requêtes par étape du pipeline
# Ajuster selon la VRAM disponible :
# des valeurs plus petites utilisent moins de mémoire.
# WHISPER_BATCH_SIZE=4
# ALIGN_BATCH_SIZE=8
# DIARIZE_BATCH_SIZE=2

# Temps d’attente avant traitement du lot disponible
# BATCH_WAIT_TIMEOUT=0.1

# Allocation fractionnée du GPU par étape
# (la somme doit être proche de 1.0 par GPU)
# WHISPER_GPU_FRACTION=0.5
# ALIGN_GPU_FRACTION=0.3
# DIARIZE_GPU_FRACTION=0.2

# Nombre de réplicas par étape
# (valeur par défaut pour toutes les étapes)
# Définir au nombre de GPU pour placer
# un pipeline complet par périphérique.
# NUM_GPU_REPLICAS=1
#
# Surcharges spécifiques par étape
# (utilisent NUM_GPU_REPLICAS si non définies) :
# WHISPER_NUM_REPLICAS=2
# ALIGN_NUM_REPLICAS=1
# DIARIZE_NUM_REPLICAS=1
#
# Exemples de configuration :
#
#   Replicate (4 GPU, pipeline complet sur chacun) :
#     NUM_GPU_REPLICAS=4
#     (les fractions restent à 0.5 / 0.3 / 0.2 —
#      Ray place un ensemble complet par GPU)
#
#   Split (3 GPU, une étape par GPU) :
#     WHISPER_GPU_FRACTION=1.0
#     ALIGN_GPU_FRACTION=1.0
#     DIARIZE_GPU_FRACTION=1.0
#
#   Hybride (4 GPU, 2 Whisper + 1 Align + 1 Diarize) :
#     WHISPER_NUM_REPLICAS=2  WHISPER_GPU_FRACTION=1.0
#     ALIGN_NUM_REPLICAS=1    ALIGN_GPU_FRACTION=1.0
#     DIARIZE_NUM_REPLICAS=1  DIARIZE_GPU_FRACTION=1.0
